[206.644379, "o", "\u001b[7muv run python - <<'PY'\u001b[27m\r\n\r\u001b[7mfrom valutatrade_hub.core.utils import load_json, save_json\u001b[27m\r\n\r\n\r\u001b[7musername = \"demo_18\"\u001b[27m\r\n\r\n\r\u001b[7musers = load_json(\"users.json\", [])\u001b[27m\r\n\r\u001b[7muser = next(item for item in users if item[\"username\"] == username)\u001b[27m\r\n\r\n\r\u001b[7mportfolios = load_json(\"portfolios.json\", [])\u001b[27m\r\n\r\u001b[7mportfolio = next(\u001b[27m\r\n\r\u001b[7m    item for item in portfolios if item[\"user_id\"] == user[\"user_id\"]\u001b[27m\r\n\r\u001b[7m)\u001b[27m\r\n\r\n\r\u001b[7mportfolio.setdefault(\"wallets\", {})[\"USD\"] = {\"balance\": 100000.0}\u001b[27m\r\n\r\u001b[7msave_json(\"portfolios.json\", portfolios)\u001b[27m\r\n\r\n\r\u001b[7mprint(\"Демонстрационный баланс добавлен: 100000 USD\")\u001b[27m\r\n\r\u001b[7mPY\u001b[27m"]
[209.725671, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\r\u001b]0;adm1@DESKTOP-DQT4NOC: /mnt/c/Users/adm/Documents/Python/finalproject_Ulyanov_M26-555\u0007\u001b[01;32madm1@DESKTOP-DQT4NOC\u001b[00m:\u001b[01;34m/mnt/c/Users/adm/Documents/Python/finalproject_Ulyanov_M26-555\u001b[00m$ uv run python - <<'PY'\r\n\rfrom valutatrade_hub.core.utils import load_json, save_json\r\n\r\n\rusername = \"demo_18\"\r\n\r\n\rusers = load_json(\"users.json\", [])\r\n\ruser = next(item for item in users if item[\"username\"] == username)\r\n\r\n\rportfolios = load_json(\"portfolios.json\", [])\r\n\rportfolio = next(\r\n\r    item for item in portfolios if item[\"user_id\"] == user[\"user_id\"]\r\n\r)\r\n\r\n\rportfolio.setdefault(\"wallets\", {})[\"USD\"] = {\"balance\": 100000.0}\r\n\rsave_json(\"portfolios.json\", portfolios)\r\n\r\n\rprint(\"Демонстрационный баланс добавлен: 100000 USD\")\r\n\rPY\r\n"]
